<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Snake Game</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            background-color: #222;
            font-family: Arial, sans-serif;
            color: white;
        }
        h1 {
            margin-bottom: 10px;
        }
        #gameCanvas {
            border: 2px solid #333;
            background-color: #111;
            display: block;
        }
        #score {
            font-size: 1.5em;
        }
        #highScore {
            font-size: 1em;
            color: #aaa;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <h1>Snake Game</h1>
    <canvas id="gameCanvas" width="400" height="400"></canvas>
    <p>Score: <span id="score">0</span></p>
    <p id="highScore">Best: 0</p>
        <div id="xpDisplay" style="color:#aaa;font-size:0.9em;"></div>
        <div id="comboDisplay" style="color:#FFD700;font-size:1.2em;min-height:1.5em;"></div>
        <div id="toast" style="display:none;position:fixed;top:20px;left:50%;transform:translateX(-50%);color:#FFD700;font-size:24px;font-weight:bold;text-shadow:2px 2px 4px rgba(0,0,0,0.8);z-index:1000;pointer-events:none;text-align:center;"></div>
        <div id="statsPanel" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.95);border:2px solid #555;border-radius:10px;padding:20px;color:white;font-family:monospace;z-index:100;min-width:300px;max-width:400px;"></div>
        <div id="achievementsPanel" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.96);border:2px solid #FFD700;border-radius:12px;padding:20px;color:white;font-family:sans-serif;z-index:100;min-width:350px;max-width:480px;"></div>
        <div id="cosmeticsPanel" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.96);border:2px solid #9B59B6;border-radius:12px;padding:20px;color:white;font-family:sans-serif;z-index:100;min-width:320px;"></div>

    <script>
        const TILE_SIZE = 20;
        const CANVAS_WIDTH = 400;
        const CANVAS_HEIGHT = 400;
        const BASE_SPEED = 120;
        const MIN_SPEED = 50;

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');
        const highScoreEl = document.getElementById('highScore');

        let snake = [];
        let food = {};
        let dx = 0;
        let dy = 0;
        let score = 0;
        let highScore;
        try { highScore = parseInt(localStorage.getItem('snake_high_score')) || 0; } catch(e) { highScore = 0; }
        let gameInterval = null;
        let gameState = 'idle';
        let nextDirection = null;
        let audioCtx = null;
        let muted;
        try { muted = parseInt(localStorage.getItem('snake_muted')) || 0; } catch(e) { muted = 0; }
        let particles = [];
        let displayedScore = 0;

        // === PROGRESSION SYSTEM ===
        let stats = loadStats();
        let xp;
        try { xp = parseInt(localStorage.getItem('snake_xp')) || 0; } catch(e) { xp = 0; }
        let level = getLevelFromXP(xp);
        let sessionXP = 0; // reserved for achievements
        let gameTick = 0;
        let comboCount = 0;
        let lastEatTime = 0;
        let sessionStartTime = 0;
        let sessionFoodEaten = 0;
        let sessionFoodTypes = new Set();
        let sessionSpeedFood = 0; // will be used in future achievements
        let sessionBonusFood = 0; // will be used in future achievements
        let sessionTimeAlive = 0;
        let sessionMaxCombo = 0;
        let sessionPauseStart = 0;
        let sessionPausedTime = 0;
        let comboFadeTimer = null;

        // === ACHIEVEMENT SYSTEM ===
        const ACHIEVEMENTS = {
            FIRST_BITE: { name:'First Bite', desc:'Eat your first food ever', xp:25, icon:'🍽️', check:function(s,c){return s.totalFoodEaten>=1;} },
            CENTURY: { name:'Century', desc:'Score 100 in one game', xp:100, icon:'💯', check:function(s,c){return c.sessionScore>=100;} },
            QUINTESSENCE: { name:'Quintessence', desc:'Score 500 in one game', xp:300, icon:'🌟', check:function(s,c){return c.sessionScore>=500;} },
            BONUS_FEAST: { name:'Bonus Feast', desc:'Eat 10 bonus foods total', xp:100, icon:'🥇', check:function(s,c){return s.bonusFoodEaten>=10;} },
            SPEED_DEMON: { name:'Speed Demon', desc:'Eat 10 speed foods total', xp:100, icon:'⚡', check:function(s,c){return s.speedFoodEaten>=10;} },
            GOURMAND: { name:'Gourmand', desc:'Eat 100 normal foods total', xp:200, icon:'🍕', check:function(s,c){return s.normalFoodEaten>=100;} },
            GLUTTON: { name:'Glutton', desc:'Eat 20 foods in one game', xp:150, icon:'🤤', check:function(s,c){return c.sessionFoodEaten>=20;} },
            SURVIVOR: { name:'Survivor', desc:'Survive 1 minute in one game', xp:100, icon:'⏱️', check:function(s,c){return c.sessionTimeAlive>=60000;} },
            MARATHONER: { name:'Marathoner', desc:'Survive 3 minutes in one game', xp:300, icon:'⏳', check:function(s,c){return c.sessionTimeAlive>=180000;} },
            LONG_BOI: { name:'Long Boi', desc:'Reach snake length 20', xp:150, icon:'🐍', check:function(s,c){return c.snakeLength>=20;} },
            SERPENT: { name:'Serpent', desc:'Reach snake length 50', xp:400, icon:'🐉', check:function(s,c){return c.snakeLength>=50;} },
            HAT_TRICK: { name:'Hat Trick', desc:'Eat all 3 food types in one game', xp:150, icon:'🎩', check:function(s,c){return c.hatTrickEligible;} },
            COMBO_3: { name:'Combo Lord', desc:'Reach 3x combo', xp:150, icon:'🔥', check:function(s,c){return c.maxCombo>=3;} },
            COMBO_5: { name:'Combo Master', desc:'Reach 5x combo', xp:300, icon:'💥', check:function(s,c){return c.maxCombo>=5;} },
        };

        let achievements = loadAchievements();

        // === COSMETICS SYSTEM ===
        const SNAKE_SKINS = {
            snake_green: { name:'Classic Green', head:'#00FF00', body:'#00CC00', unlock:1 },
            snake_cyan: { name:'Cyan', head:'#00FFFF', body:'#00CCCC', unlock:2 },
            snake_purple: { name:'Purple', head:'#9B59B6', body:'#7D3C98', unlock:4 },
            snake_gold: { name:'Gold', head:'#FFD700', body:'#DAA520', unlock:7 },
            snake_fire: { name:'Fire', head:'#FF4500', body:'#8B0000', unlock:10 },
            snake_rainbow: { name:'Rainbow', head:'rainbow', body:'rainbow', unlock:15 },
        };

        const GRID_THEMES = {
            grid_classic: { name:'Classic Grid', stroke:'rgba(255,255,255,0.04)', bg:'#111', unlock:1 },
            grid_neon: { name:'Neon Grid', stroke:'rgba(0,255,255,0.08)', bg:'#0a0a1a', unlock:3 },
            grid_matrix: { name:'Matrix Grid', stroke:'rgba(0,255,65,0.1)', bg:'#000', unlock:12 },
        };

        const TRACE_EFFECTS = {
            trace_none: { name:'No Trail', unlock:1 },
            trace_ghost: { name:'Ghost Trail', unlock:9 },
            trace_sparkle: { name:'Sparkle Trail', unlock:15 },
        };

        const DEATH_EFFECTS = {
            death_classic: { name:'Classic Burst', color:'#FF4500', count:30, unlock:1 },
            death_blue: { name:'Blue Burst', color:'#4488FF', count:30, unlock:13 },
            death_rainbow: { name:'Rainbow Burst', color:'rainbow', count:50, unlock:20 },
        };

        const LEVEL_UNLOCKS = {
            2:['snake_cyan'], 3:['grid_neon'], 4:['snake_purple'],
            7:['snake_gold'], 9:['trace_ghost'], 10:['snake_fire'],
            12:['grid_matrix'], 13:['death_blue'], 15:['snake_rainbow','trace_sparkle'],
            20:['death_rainbow']
        };

        let unlockedCosmetics = loadUnlocked();
        let cosmetics = loadEquipped();

        function loadUnlocked() {
            try {
                const data = JSON.parse(localStorage.getItem('snake_unlocks'));
                if (data && Array.isArray(data) && data.length > 0) return data;
            } catch(e) {}
            return ['snake_green','grid_classic','trace_none','death_classic'];
        }

        function loadEquipped() {
            try {
                const data = JSON.parse(localStorage.getItem('snake_equipped'));
                if (data && data.snake) return data;
            } catch(e) {}
            return { snake:'snake_green', grid:'grid_classic', trace:'trace_none', death:'death_classic' };
        }

        function loadAchievements() {
            try { return JSON.parse(localStorage.getItem('snake_achievements')) || {}; }
            catch(e) { return {}; }
        }

        // === GAME MODES ===
        const MODE_CONFIG = {
            classic: {
                name:'Classic', speed:'dynamic', selfCollision:true, wallDeath:false, wrap:true,
                timer:null, scoreIs:'points', earnXP:true, achievementsEnabled:true,
                foodProbs:{normal:0.80,bonus:0.15,speed:0.05}
            },
            timeAttack: {
                name:'Time Attack', speed:80, selfCollision:true, wallDeath:false, wrap:true,
                timer:60000, scoreIs:'points', earnXP:true, achievementsEnabled:true,
                foodProbs:{normal:0.70,bonus:0.30}
            },
            zen: {
                name:'Zen', speed:150, selfCollision:false, wallDeath:false, wrap:true,
                timer:null, scoreIs:'length', earnXP:false, achievementsEnabled:false,
                foodProbs:{normal:0.80,bonus:0.20}
            }
        };

        const MODE_ORDER = ['classic', 'timeAttack', 'zen'];
        let gameMode = 'classic';
        let modeSelectIndex = 0;
        let timeAttackEnd = 0;
        let zenActive = false;
        let modeHighScores = loadModeHighScores();

        function loadModeHighScores() {
            try { return JSON.parse(localStorage.getItem('snake_mode_highs')) || {}; }
            catch(e) { return {}; }
        }

        function getModeDesc(mode) {
            const descs = {
                classic: 'Standard Snake. Wall wrapping, speed increases with score.',
                timeAttack: 'Score max points in 60 seconds. Fixed speed, bonus food worth +50.',
                zen: 'No death from collisions. Relax and grow. Score = snake length.'
            };
            return descs[mode] || '';
        }

        highScoreEl.textContent = 'Best: ' + highScore;

        function getSpeed() {
            const mc = MODE_CONFIG[gameMode];
            if (typeof mc.speed === 'number') return mc.speed;
            return Math.max(MIN_SPEED, BASE_SPEED - Math.floor(score / 50) * 5);
        }

        function generateFood(currentSnake) {
            if (currentSnake.length >= (CANVAS_WIDTH / TILE_SIZE) * (CANVAS_HEIGHT / TILE_SIZE)) return null;
            let newFood;
            do {
                const rand = Math.random();
                let type;
                const mc = MODE_CONFIG[gameMode];
                const probs = mc.foodProbs;
                let cumulative = 0;
                for (const t in probs) {
                    cumulative += probs[t];
                    if (rand < cumulative) { type = t; break; }
                }
                if (!type) type = 'normal';
                newFood = {
                    x: Math.floor(Math.random() * (CANVAS_WIDTH / TILE_SIZE)) * TILE_SIZE,
                    y: Math.floor(Math.random() * (CANVAS_HEIGHT / TILE_SIZE)) * TILE_SIZE,
                    type: type
                };
            } while (currentSnake.some(segment => segment.x === newFood.x && segment.y === newFood.y));
            return newFood;
        }

        function resetGame() {
            comboCount = 0;
            sessionFoodEaten = 0;
            sessionFoodTypes = new Set();
            sessionSpeedFood = 0;
            sessionBonusFood = 0;
            gameTick = 0;
            lastEatTime = 0;
            sessionXP = 0;
            sessionPauseStart = 0;
            sessionPausedTime = 0;
            sessionTimeAlive = 0;
            sessionMaxCombo = 0;

            snake = [{ x: 10 * TILE_SIZE, y: 10 * TILE_SIZE }];
            dx = TILE_SIZE;
            dy = 0;
            food = generateFood(snake);
            score = 0;
            displayedScore = 0;
            particles = [];
            gameState = 'idle';
            gameInterval = null;
            nextDirection = null;
            updateScoreDisplay();
            drawGame();
            timeAttackEnd = 0;
            zenActive = false;
        }

        function updateScoreDisplay() {
            if (score > (modeHighScores[gameMode] || 0)) {
                modeHighScores[gameMode] = score;
                try { localStorage.setItem('snake_mode_highs', JSON.stringify(modeHighScores)); } catch(e) {}
            }
            if (score > highScore) {
                highScore = score;
                try { localStorage.setItem('snake_high_score', highScore); } catch(e) { /* localStorage unavailable */ }
            }
            if (modeHighScores[gameMode]) {
                highScoreEl.textContent = 'Best (' + MODE_CONFIG[gameMode].name + '): ' + modeHighScores[gameMode];
            } else {
                highScoreEl.textContent = 'Best: ' + highScore;
            }
        }

        function startGame() {
            const mc = MODE_CONFIG[gameMode];
            if (mc.timer) timeAttackEnd = Date.now() + mc.timer;
            if (gameMode === 'zen') zenActive = true;
            sessionStartTime = Date.now();
            gameState = 'playing';
            gameInterval = setInterval(updateGame, getSpeed());
            drawGame();
        }

        function checkCollision(pos) {
            const mc = MODE_CONFIG[gameMode];
            if (!mc.selfCollision) return false;
            for (let i = 0; i < snake.length; i++) {
                if (pos.x === snake[i].x && pos.y === snake[i].y) return true;
            }
            return false;
        }

        function wrapPosition(pos) {
            return {
                x: ((pos.x % CANVAS_WIDTH) + CANVAS_WIDTH) % CANVAS_WIDTH,
                y: ((pos.y % CANVAS_HEIGHT) + CANVAS_HEIGHT) % CANVAS_HEIGHT
            };
        }

        function gameOver() {
            clearInterval(gameInterval);
            gameInterval = null;
            gameState = 'gameover';
            sessionTimeAlive = Date.now() - sessionStartTime - sessionPausedTime;
            stats.gamesPlayed++;
            stats.totalScore += score;
            stats.totalDeaths++;
            stats.totalTimePlayed += sessionTimeAlive;
            if (score > stats.maxScore) stats.maxScore = score;
            if (sessionTimeAlive > stats.longestTimeAlive) stats.longestTimeAlive = sessionTimeAlive;
            awardXP(snake.length * 10);
            saveAllState();
            checkAchievements(score);
            // Per-mode high score
            if (score > (modeHighScores[gameMode] || 0)) {
                modeHighScores[gameMode] = score;
                try { localStorage.setItem('snake_mode_highs', JSON.stringify(modeHighScores)); } catch(e) {}
            }
            const de = DEATH_EFFECTS[cosmetics.death] || DEATH_EFFECTS.death_classic;
            if (de.color === 'rainbow') {
                const perColor = Math.floor(de.count / 3);
                const extra = de.count - perColor * 3;
                spawnParticles(snake[0].x, snake[0].y, perColor + (extra > 0 ? 1 : 0), '#FF0000');
                spawnParticles(snake[0].x, snake[0].y, perColor + (extra > 1 ? 1 : 0), '#00FF00');
                spawnParticles(snake[0].x, snake[0].y, perColor, '#0000FF');
            } else {
                spawnParticles(snake[0].x, snake[0].y, de.count, de.color);
            }
            playSound('gameover');
            drawGame();
        }

        function endZenSession() {
            gameState = 'gameover';
            score = snake.length;
            sessionTimeAlive = Date.now() - sessionStartTime - sessionPausedTime;
            stats.gamesPlayed++;
            stats.totalScore += score;
            stats.totalDeaths++;
            stats.totalTimePlayed += sessionTimeAlive;
            if (score > stats.maxScore) stats.maxScore = score;
            if (sessionTimeAlive > stats.longestTimeAlive) stats.longestTimeAlive = sessionTimeAlive;
            if (snake.length > stats.longestLength) stats.longestLength = snake.length;
            saveAllState();
            if (score > (modeHighScores[gameMode] || 0)) {
                modeHighScores[gameMode] = score;
                try { localStorage.setItem('snake_mode_highs', JSON.stringify(modeHighScores)); } catch(e) {}
            }
            zenActive = false;
            drawGame();
        }

        function playSound(name) {
            if (muted) return;
            if (!audioCtx) {
                try {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {
                    return;
                }
            }
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            gain.gain.value = 0.2;
            const now = audioCtx.currentTime;

            switch (name) {
                case 'eat':
                    osc.frequency.value = 523;
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                    break;
                case 'bonus':
                    osc.frequency.value = 523;
                    osc.frequency.linearRampToValueAtTime(1047, now + 0.15);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
                    osc.start(now);
                    osc.stop(now + 0.15);
                    break;
                case 'speed':
                    osc.frequency.value = 440;
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                    osc.start(now);
                    osc.stop(now + 0.06);
                    break;
                case 'gameover':
                    osc.frequency.value = 440;
                    osc.frequency.linearRampToValueAtTime(220, now + 0.5);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                    osc.start(now);
                    osc.stop(now + 0.5);
                    break;
                case 'pause':
                    osc.frequency.value = 330;
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                    break;
                case 'resume':
                    osc.frequency.value = 440;
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                    break;
            }
        }

        function spawnParticles(x, y, count, color) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x + TILE_SIZE / 2,
                    y: y + TILE_SIZE / 2,
                    vx: (Math.random() - 0.5) * 6,
                    vy: (Math.random() - 0.5) * 6,
                    life: 1.0,
                    maxLife: count > 20 ? 1.0 : 0.5,
                    color: color,
                    size: Math.random() * 3 + 2
                });
            }
        }

        function animateVisuals() {
            // Update and draw particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.vy += 0.05; // gravity
                p.life -= 16 / (p.maxLife * 1000); // ~60fps normalized
                if (p.life <= 0) {
                    particles.splice(i, 1);
                }
            }

            // Redraw game + particles
            drawGame();

            if (cosmetics.trace === 'trace_ghost' && snake.length >= 4) {
                const skin = SNAKE_SKINS[cosmetics.snake] || SNAKE_SKINS.snake_green;
                const trailColor = skin.head === 'rainbow' ? '#00FF00' : skin.head;
                for (let t = 0; t < 3; t++) {
                    const idx = snake.length - 1 - t;
                    if (idx < 0) break;
                    const seg = snake[idx];
                    ctx.globalAlpha = 0.15 - t * 0.05;
                    ctx.fillStyle = trailColor;
                    ctx.fillRect(seg.x, seg.y, TILE_SIZE - 1, TILE_SIZE - 1);
                }
                ctx.globalAlpha = 1;
            }

            if (cosmetics.trace === 'trace_sparkle' && gameTick % 5 === 0 && snake.length > 1) {
                const tail = snake[snake.length - 1];
                spawnParticles(tail.x, tail.y, 2, '#FFD700');
            }

            for (const p of particles) {
                const alpha = Math.max(0, p.life);
                ctx.globalAlpha = alpha;
                ctx.fillStyle = p.color;
                ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
            }
            ctx.globalAlpha = 1;

            // Animate score
            const delta = score - displayedScore;
            if (delta > 1) {
                displayedScore += Math.ceil(delta * 0.3);
            } else if (delta > 0) {
                displayedScore = score;
            }
            scoreEl.textContent = displayedScore;

            const comboEl = document.getElementById('comboDisplay');
            if (comboEl) {
                const mul = 1 + comboCount * 0.5;
                comboEl.textContent = comboCount > 0 ? 'x' + mul.toFixed(1) + ' COMBO!' : '';
                if (comboCount > 0) {
                    clearTimeout(comboFadeTimer);
                    comboFadeTimer = setTimeout(function() {
                        document.getElementById('comboDisplay').textContent = '';
                    }, 3500);
                }
            }
            const xpEl = document.getElementById('xpDisplay');
            if (xpEl) {
                xpEl.textContent = 'Lv.' + level + ' | XP: ' + xp.toLocaleString();
            }

// Zen mode: score = snake length
            if (gameMode === 'zen') {
                score = snake.length;
            }

            requestAnimationFrame(animateVisuals);
        }

        function drawOverlay(text, subtext) {
            if (gameState === 'idle') {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
                ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
                ctx.fillStyle = '#FFF';
                ctx.font = 'bold 32px Arial';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('SNAKE', CANVAS_WIDTH / 2, 60);
                ctx.font = '20px Arial';
                for (let i = 0; i < MODE_ORDER.length; i++) {
                    const mode = MODE_ORDER[i];
                    const cfg = MODE_CONFIG[mode];
                    const y = 140 + i * 60;
                    const isSelected = i === modeSelectIndex;
                    ctx.fillStyle = isSelected ? '#FFD700' : '#666';
                    ctx.font = isSelected ? 'bold 22px Arial' : '18px Arial';
                    ctx.fillText((isSelected ? '▶ ' : '  ') + cfg.name + (modeHighScores[mode] ? ' (Best: ' + modeHighScores[mode] + ')' : ''), CANVAS_WIDTH / 2, y);
                    if (isSelected) {
                        ctx.fillStyle = '#AAA';
                        ctx.font = '13px Arial';
                        ctx.fillText(getModeDesc(mode), CANVAS_WIDTH / 2, y + 22);
                    }
                }
                ctx.fillStyle = '#888';
                ctx.font = '14px Arial';
                ctx.fillText('Lv.' + level + ' | XP: ' + xp.toLocaleString(), CANVAS_WIDTH / 2, CANVAS_HEIGHT - 60);
                ctx.fillStyle = '#555';
                ctx.font = '13px Arial';
                ctx.fillText('↑↓ Select  |  ENTER Start  |  TAB Stats  |  F Achievements  |  C Cosmetics', CANVAS_WIDTH / 2, CANVAS_HEIGHT - 30);
                return;
            }
            ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
            ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
            ctx.fillStyle = '#FFF';
            ctx.font = 'bold 36px Arial';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(text, CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 - 20);
            if (subtext) {
                ctx.font = '18px Arial';
                ctx.fillStyle = '#AAA';
                ctx.fillText(subtext, CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 25);
            }
            if (gameState === 'gameover') {
                ctx.font = '13px Arial';
                ctx.fillStyle = '#888';
                ctx.fillText('Mode: ' + MODE_CONFIG[gameMode].name, CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 55);
            }
        }

        function drawGrid() {
            const theme = GRID_THEMES[cosmetics.grid] || GRID_THEMES.grid_classic;
            ctx.strokeStyle = theme.stroke;
            ctx.lineWidth = 1;
            ctx.fillStyle = theme.bg;
            ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
            for (let x = 0; x <= CANVAS_WIDTH; x += TILE_SIZE) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, CANVAS_HEIGHT);
                ctx.stroke();
            }
            for (let y = 0; y <= CANVAS_HEIGHT; y += TILE_SIZE) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(CANVAS_WIDTH, y);
                ctx.stroke();
            }
        }

        function drawFood() {
            if (!food) return;
            if (food.type === 'bonus') {
                const pulse = 1 + 0.5 * Math.sin(Date.now() / 200);
                const size = Math.round(TILE_SIZE * pulse);
                const offset = Math.round((TILE_SIZE - size) / 2);
                ctx.fillStyle = '#FFD700';
                ctx.fillRect(food.x + offset, food.y + offset, size, size);
            } else if (food.type === 'speed') {
                ctx.fillStyle = '#00FFFF';
                ctx.fillRect(food.x, food.y, TILE_SIZE, TILE_SIZE);
            } else {
                ctx.fillStyle = 'red';
                ctx.fillRect(food.x, food.y, TILE_SIZE, TILE_SIZE);
            }
        }

        function drawSnake() {
            const skin = SNAKE_SKINS[cosmetics.snake] || SNAKE_SKINS.snake_green;
            snake.forEach(function(segment, index) {
                if (skin.head === 'rainbow') {
                    const hue = (index * 20 + Date.now() * 0.05) % 360;
                    ctx.fillStyle = 'hsl(' + hue + ', 100%, 50%)';
                } else {
                    ctx.fillStyle = index === 0 ? skin.head : skin.body;
                }
                ctx.fillRect(segment.x, segment.y, TILE_SIZE - 1, TILE_SIZE - 1);

                if (index === 0) {
                    let ex1, ey1, ex2, ey2;
                    if (dx > 0) {
                        ex1 = segment.x + 12; ey1 = segment.y + 4;
                        ex2 = segment.x + 12; ey2 = segment.y + 12;
                    } else if (dx < 0) {
                        ex1 = segment.x + 4; ey1 = segment.y + 4;
                        ex2 = segment.x + 4; ey2 = segment.y + 12;
                    } else if (dy < 0) {
                        ex1 = segment.x + 4; ey1 = segment.y + 4;
                        ex2 = segment.x + 12; ey2 = segment.y + 4;
                    } else {
                        ex1 = segment.x + 4; ey1 = segment.y + 12;
                        ex2 = segment.x + 12; ey2 = segment.y + 12;
                    }
                    ctx.fillStyle = 'white';
                    ctx.beginPath(); ctx.arc(ex1, ey1, 4, 0, 2 * Math.PI); ctx.fill();
                    ctx.beginPath(); ctx.arc(ex2, ey2, 4, 0, 2 * Math.PI); ctx.fill();
                    ctx.fillStyle = 'black';
                    ctx.beginPath(); ctx.arc(ex1, ey1, 2, 0, 2 * Math.PI); ctx.fill();
                    ctx.beginPath(); ctx.arc(ex2, ey2, 2, 0, 2 * Math.PI); ctx.fill();
                }
            });
        }

        function drawGame() {
            drawGrid();
            drawFood();
            drawSnake();

            // Time Attack HUD
            if (gameMode === 'timeAttack' && gameState === 'playing' && timeAttackEnd > 0) {
                const remaining = Math.max(0, Math.ceil((timeAttackEnd - Date.now()) / 1000));
                ctx.fillStyle = remaining <= 10 ? '#FF4444' : '#FFD700';
                ctx.font = 'bold 18px Arial';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'top';
                ctx.fillText('TIME: ' + remaining + 's', CANVAS_WIDTH / 2, 5);
            }

            if (gameState === 'idle') {
                drawOverlay('SNAKE', 'Press ENTER to Start');
            } else if (gameState === 'paused') {
                drawOverlay('PAUSED', 'Press P or SPACE to Resume');
            } else if (gameState === 'gameover') {
                drawOverlay('GAME OVER', 'Score: ' + score + ' | Press ENTER to Restart');
            }
        }

        function updateGame() {
            if (gameState !== 'playing') return;

            gameTick++;
            stats.totalDistance++;
            if (gameTick % 10 === 0) awardXP(1);

            // Time Attack timer
            if (gameMode === 'timeAttack' && timeAttackEnd > 0) {
                const remaining = timeAttackEnd - Date.now();
                if (remaining <= 0) { gameOver(); return; }
            }

            if (nextDirection) {
                if (nextDirection.dx !== -dx || nextDirection.dy !== -dy) {
                    dx = nextDirection.dx;
                    dy = nextDirection.dy;
                }
                nextDirection = null;
            }

            const tail = snake.pop();

            const headRef = snake.length > 0 ? snake[0] : tail;
            const newHead = {
                x: headRef.x + dx,
                y: headRef.y + dy
            };
            const wrappedHead = wrapPosition(newHead);

            if (checkCollision(wrappedHead)) {
                snake.push(tail);
                gameOver();
                return;
            }

            snake.unshift(wrappedHead);

            if (wrappedHead.x === food.x && wrappedHead.y === food.y) {
                snake.push(tail);
                const eatenType = food.type;

                // Stats tracking
                sessionFoodTypes.add(eatenType);
                sessionFoodEaten++;
                stats.totalFoodEaten++;
                if (eatenType === 'normal') stats.normalFoodEaten++;
                else if (eatenType === 'bonus') { stats.bonusFoodEaten++; sessionBonusFood++; }
                else if (eatenType === 'speed') { stats.speedFoodEaten++; sessionSpeedFood++; }

                // Combo logic
                const now = Date.now();
                if (now - lastEatTime < 3000 && lastEatTime > 0) {
                    comboCount = Math.min(5, comboCount + 1);
                } else {
                    comboCount = 0;
                }
                lastEatTime = now;
                if (comboCount > stats.maxCombo) stats.maxCombo = comboCount;
                if (comboCount > sessionMaxCombo) sessionMaxCombo = comboCount;

                // XP award for eating
                const foodXPMap = { normal: 25, bonus: 60, speed: 40 };
                const foodXP = foodXPMap[eatenType] || 10;
                const comboMul = 1 + comboCount * 0.5;
                awardXP(Math.round(foodXP * comboMul));

                // Track longest length
                if (snake.length > stats.longestLength) stats.longestLength = snake.length;

                let particleColor = eatenType === 'bonus' ? '#FFD700' : eatenType === 'speed' ? '#00FFFF' : '#00FF00';
                spawnParticles(wrappedHead.x, wrappedHead.y, 12, particleColor);
                if (eatenType === 'bonus') {
                    if (gameMode !== 'zen') score += (gameMode === 'timeAttack' ? 50 : 30);
                    playSound('bonus');
                } else if (eatenType === 'speed') {
                    if (gameMode !== 'zen') score += 5;
                    playSound('speed');
                    clearInterval(gameInterval);
                    gameInterval = setInterval(updateGame, Math.max(MIN_SPEED, getSpeed() - 30));
                    const ci = gameInterval;
                    setTimeout(() => {
                        if (gameInterval === ci && gameState === 'playing') {
                            clearInterval(gameInterval);
                            gameInterval = setInterval(updateGame, getSpeed());
                        }
                    }, 2000);
                } else {
                    if (gameMode !== 'zen') score += 10;
                    playSound('eat');
                }
                updateScoreDisplay();
                checkAchievements(score);
                food = generateFood(snake);
                if (!food) { gameOver(); return; }
                if (eatenType !== 'speed') {
                    clearInterval(gameInterval);
                    gameInterval = setInterval(updateGame, getSpeed());
                }
            }

            drawGame();
        }

        function getLevelFromXP(xp) {
            let n = 1;
            while (true) {
                const required = 100 * n * (n + 1) / 2;
                if (xp < required) return n;
                n++;
            }
        }

        function awardXP(amount) {
            const mc = MODE_CONFIG[gameMode];
            if (!mc.earnXP) return;
            xp += amount;
            sessionXP += amount;
            const newLevel = getLevelFromXP(xp);
            while (newLevel > level) {
                level++;
                showLevelUpToast(level);
                checkLevelUnlocks(level);
            }
            try { localStorage.setItem('snake_xp', xp); } catch(e) { /* localStorage unavailable */ }
        }

        function loadStats() {
            try { return JSON.parse(localStorage.getItem('snake_stats')) || getDefaultStats(); }
            catch(e) { return getDefaultStats(); }
        }

        function getDefaultStats() {
            return {
                gamesPlayed: 0, totalScore: 0, maxScore: 0,
                totalFoodEaten: 0, normalFoodEaten: 0, bonusFoodEaten: 0, speedFoodEaten: 0,
                longestLength: 0, longestTimeAlive: 0, totalTimePlayed: 0,
                totalDistance: 0, maxCombo: 0, totalDeaths: 0
            };
        }

        function saveAllState() {
            try { localStorage.setItem('snake_stats', JSON.stringify(stats)); } catch(e) { /* localStorage unavailable */ }
        }

        function showLevelUpToast(level) {
            const el = document.getElementById('toast');
            if (!el) return;
            el.textContent = '⚡ LEVEL UP! Level ' + level + ' ⚡';
            el.style.display = 'block';
            window.lvlToastTimer = setTimeout(function() { el.style.display = 'none'; }, 3000);
        }

        function checkLevelUnlocks(newLevel) {
            const unlocks = LEVEL_UNLOCKS[newLevel] || [];
            for (let i = 0; i < unlocks.length; i++) {
                const id = unlocks[i];
                if (unlockedCosmetics.indexOf(id) === -1) {
                    unlockedCosmetics.push(id);
                    try { localStorage.setItem('snake_unlocks', JSON.stringify(unlockedCosmetics)); } catch(e) {}
                    const allCosmetics = Object.assign({}, SNAKE_SKINS, GRID_THEMES, TRACE_EFFECTS, DEATH_EFFECTS);
                    const c = allCosmetics[id];
                    if (c) {
                        const el = document.getElementById('toast');
                        if (el) {
                            el.textContent = '🎨 Unlocked: ' + c.name + '!';
                            el.style.display = 'block';
                            if (window.lvlToastTimer) clearTimeout(window.lvlToastTimer);
                            window.lvlToastTimer = setTimeout(function() { el.style.display = 'none'; }, 3000);
                        }
                    }
                }
            }
        }

        function checkAchievements(sessionScore) {
            const mc = MODE_CONFIG[gameMode];
            if (!mc.achievementsEnabled) return;
            let unlockedAny = false;
            const ctx = {
                sessionFoodEaten: sessionFoodEaten,
                sessionTimeAlive: sessionTimeAlive,
                snakeLength: snake.length,
                hatTrickEligible: sessionFoodTypes.size === 3,
                maxCombo: sessionMaxCombo,
                sessionScore: sessionScore || score
            };
            for (const id in ACHIEVEMENTS) {
                if (achievements[id]) continue;
                const ach = ACHIEVEMENTS[id];
                if (ach.check(stats, ctx)) {
                    achievements[id] = Date.now();
                    try { localStorage.setItem('snake_achievements', JSON.stringify(achievements)); } catch(e) {}
                    awardXP(ach.xp);
                    showAchievementToast(ach);
                    unlockedAny = true;
                }
            }
        }

        function showAchievementToast(ach) {
            const el = document.getElementById('toast');
            if (!el) return;
            el.textContent = '🏆 ' + ach.icon + ' ' + ach.name + ': ' + ach.desc + ' (+' + ach.xp + ' XP)';
            el.style.display = 'block';
            if (window.achToastTimer) clearTimeout(window.achToastTimer);
            if (window.lvlToastTimer) clearTimeout(window.lvlToastTimer);
            window.achToastTimer = setTimeout(function() { el.style.display = 'none'; }, 4000);
        }

        function showAchievementsPanel() {
            const el = document.getElementById('achievementsPanel');
            if (!el) return;
            if (el.style.display === 'block') { el.style.display = 'none'; return; }
            document.getElementById('statsPanel').style.display = 'none';
            document.getElementById('cosmeticsPanel').style.display = 'none';
            let html = '<h2 style="text-align:center;margin-top:0;color:#FFD700;">🏆 ACHIEVEMENTS</h2><div style="max-height:400px;overflow-y:auto;">';
            for (const id in ACHIEVEMENTS) {
                const ach = ACHIEVEMENTS[id];
                const unlocked = achievements[id];
                html += '<div style="padding:10px;margin:6px 0;background:' + (unlocked ? 'rgba(255,215,0,0.12)' : 'rgba(255,255,255,0.04)') + ';border-radius:8px;border:1px solid ' + (unlocked ? 'rgba(255,215,0,0.3)' : 'rgba(255,255,255,0.1)') + ';">' +
                    '<div style="display:flex;align-items:center;justify-content:space-between;">' +
                    '<span><span style="font-size:1.3em;">' + (unlocked ? '✅' : '🔒') + '</span> ' +
                    '<strong>' + ach.icon + ' ' + ach.name + '</strong></span>' +
                    '<span style="color:' + (unlocked ? '#4CAF50' : '#FFD700') + ';font-size:0.9em;">' + (unlocked ? '✓ Unlocked' : '+' + ach.xp + ' XP') + '</span></div>' +
                    '<div style="color:#aaa;font-size:0.85em;margin-top:4px;margin-left:28px;">' + ach.desc + '</div>' +
                    (unlocked ? '<div style="color:#666;font-size:0.75em;margin-top:2px;margin-left:28px;">' + new Date(unlocked).toLocaleDateString() + '</div>' : '') +
                    '</div>';
            }
            html += '</div><p style="text-align:center;color:#666;margin-top:10px;font-size:0.85em;">Press F or ESC to close</p>';
            el.innerHTML = html;
            el.style.display = 'block';
        }

        function showCosmeticsPanel() {
            const el = document.getElementById('cosmeticsPanel');
            if (!el) return;
            if (el.style.display === 'block') { el.style.display = 'none'; return; }
            document.getElementById('statsPanel').style.display = 'none';
            document.getElementById('achievementsPanel').style.display = 'none';

            function cycle(currentId, categoryMap, direction) {
                const keys = Object.keys(categoryMap);
                const idx = keys.indexOf(currentId);
                if (idx === -1) return currentId;
                let newIdx = idx;
                const maxAttempts = keys.length;
                for (let attempt = 0; attempt < maxAttempts; attempt++) {
                    newIdx = (newIdx + direction + keys.length) % keys.length;
                    if (unlockedCosmetics.indexOf(keys[newIdx]) !== -1) return keys[newIdx];
                }
                return currentId;
            }

            function renderPanel() {
                const skin = SNAKE_SKINS[cosmetics.snake] || SNAKE_SKINS.snake_green;
                const grid = GRID_THEMES[cosmetics.grid] || GRID_THEMES.grid_classic;
                const trace = TRACE_EFFECTS[cosmetics.trace] || TRACE_EFFECTS.trace_none;
                const death = DEATH_EFFECTS[cosmetics.death] || DEATH_EFFECTS.death_classic;

                el.innerHTML =
                    '<h2 style="text-align:center;margin-top:0;color:#FFD700;">🎨 COSMETICS</h2>' +
                    '<div style="margin:12px 0;">' +
                    '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;background:rgba(255,255,255,0.05);border-radius:6px;">' +
                    '<button class="cosmetic-btn" data-cat="snake" data-dir="-1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">◀</button>' +
                    '<div style="text-align:center;"><strong>Snake</strong><br><span style="color:#aaa;font-size:0.9em;">' + skin.name + '</span></div>' +
                    '<button class="cosmetic-btn" data-cat="snake" data-dir="1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">▶</button>' +
                    '</div>' +

                    '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;background:rgba(255,255,255,0.05);border-radius:6px;margin-top:8px;">' +
                    '<button class="cosmetic-btn" data-cat="grid" data-dir="-1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">◀</button>' +
                    '<div style="text-align:center;"><strong>Grid</strong><br><span style="color:#aaa;font-size:0.9em;">' + grid.name + '</span></div>' +
                    '<button class="cosmetic-btn" data-cat="grid" data-dir="1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">▶</button>' +
                    '</div>' +

                    '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;background:rgba(255,255,255,0.05);border-radius:6px;margin-top:8px;">' +
                    '<button class="cosmetic-btn" data-cat="trace" data-dir="-1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">◀</button>' +
                    '<div style="text-align:center;"><strong>Trail</strong><br><span style="color:#aaa;font-size:0.9em;">' + trace.name + '</span></div>' +
                    '<button class="cosmetic-btn" data-cat="trace" data-dir="1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">▶</button>' +
                    '</div>' +

                    '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;background:rgba(255,255,255,0.05);border-radius:6px;margin-top:8px;">' +
                    '<button class="cosmetic-btn" data-cat="death" data-dir="-1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">◀</button>' +
                    '<div style="text-align:center;"><strong>Death Effect</strong><br><span style="color:#aaa;font-size:0.9em;">' + death.name + '</span></div>' +
                    '<button class="cosmetic-btn" data-cat="death" data-dir="1" style="background:#333;color:white;border:1px solid #555;border-radius:4px;padding:4px 12px;cursor:pointer;font-size:18px;">▶</button>' +
                    '</div>' +
                    '</div>' +
                    '<p style="text-align:center;color:#666;font-size:0.85em;">Press C or ESC to close</p>';

                el.querySelectorAll('.cosmetic-btn').forEach(function(btn) {
                    btn.addEventListener('click', function(ev) {
                        const cat = ev.target.getAttribute('data-cat');
                        const dir = parseInt(ev.target.getAttribute('data-dir'));
                        if (cat === 'snake') {
                            cosmetics.snake = cycle(cosmetics.snake, SNAKE_SKINS, dir);
                        } else if (cat === 'grid') {
                            cosmetics.grid = cycle(cosmetics.grid, GRID_THEMES, dir);
                        } else if (cat === 'trace') {
                            cosmetics.trace = cycle(cosmetics.trace, TRACE_EFFECTS, dir);
                        } else if (cat === 'death') {
                            cosmetics.death = cycle(cosmetics.death, DEATH_EFFECTS, dir);
                        }
                        try { localStorage.setItem('snake_equipped', JSON.stringify(cosmetics)); } catch(e) {}
                        renderPanel();
                    });
                });
            }

            renderPanel();
            el.style.display = 'block';
        }

        function showStatsPanel() {
            const el = document.getElementById('statsPanel');
            if (!el) return;
            if (el.style.display === 'block') { el.style.display = 'none'; return; }
            document.getElementById('achievementsPanel').style.display = 'none';
            document.getElementById('cosmeticsPanel').style.display = 'none';
            el.innerHTML = '<h2 style="text-align:center;margin-top:0;">📊 STATS</h2>' +
                '<table style="width:100%;border-collapse:collapse;">' +
                '<tr><td style="padding:4px 8px;">Games Played</td><td style="text-align:right;padding:4px 8px;">' + stats.gamesPlayed + '</td></tr>' +
                '<tr><td style="padding:4px 8px;">Total Score</td><td style="text-align:right;padding:4px 8px;">' + stats.totalScore.toLocaleString() + '</td></tr>' +
                '<tr><td style="padding:4px 8px;">Best Score</td><td style="text-align:right;padding:4px 8px;">' + stats.maxScore.toLocaleString() + '</td></tr>' +
                '<tr><td style="padding:4px 8px;">Total Food Eaten</td><td style="text-align:right;padding:4px 8px;">' + stats.totalFoodEaten + '</td></tr>' +
                '<tr><td style="padding:4px 8px;">Normal / Bonus / Speed</td><td style="text-align:right;padding:4px 8px;">' + stats.normalFoodEaten + ' / ' + stats.bonusFoodEaten + ' / ' + stats.speedFoodEaten + '</td></tr>' +
                '<tr><td style="padding:4px 8px;">Longest Snake</td><td style="text-align:right;padding:4px 8px;">' + stats.longestLength + '</td></tr>' +
                '<tr><td style="padding:4px 8px;">Longest Life</td><td style="text-align:right;padding:4px 8px;">' + Math.floor(stats.longestTimeAlive / 1000) + 's</td></tr>' +
                '<tr><td style="padding:4px 8px;">Total Time</td><td style="text-align:right;padding:4px 8px;">' + Math.floor(stats.totalTimePlayed / 60000) + 'm</td></tr>' +
                '<tr><td style="padding:4px 8px;">Total Distance</td><td style="text-align:right;padding:4px 8px;">' + stats.totalDistance + ' tiles</td></tr>' +
                '<tr><td style="padding:4px 8px;">Best Combo</td><td style="text-align:right;padding:4px 8px;">' + stats.maxCombo + 'x</td></tr>' +
                '<tr><td style="padding:4px 8px;">Deaths</td><td style="text-align:right;padding:4px 8px;">' + stats.totalDeaths + '</td></tr>' +
                '</table>' +
                '<p style="text-align:center;color:#888;margin-top:10px;font-size:0.9em;">Press TAB or ESC to close</p>';
            el.style.display = 'block';
        }

        document.addEventListener('keydown', (e) => {
            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) {
                e.preventDefault();
            }

            if (e.key === 'Enter') {
                if (gameState === 'idle') {
                    resetGame();
                    startGame();
                    return;
                }
                if (gameState === 'gameover') {
                    gameState = 'idle';
                    drawGame();
                    return;
                }
            }

            // Mode selection on idle
            if (gameState === 'idle') {
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    modeSelectIndex = (modeSelectIndex - 1 + MODE_ORDER.length) % MODE_ORDER.length;
                    gameMode = MODE_ORDER[modeSelectIndex];
                    drawGame();
                    return;
                }
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    modeSelectIndex = (modeSelectIndex + 1) % MODE_ORDER.length;
                    gameMode = MODE_ORDER[modeSelectIndex];
                    drawGame();
                    return;
                }
            }

            // Zen mode quit
            if (e.key === 'Enter' && gameState === 'playing' && gameMode === 'zen') {
                endZenSession();
                return;
            }

            if (e.key === 'p' || e.key === 'P' || e.key === ' ') {
                if (gameState === 'playing') {
                    gameState = 'paused';
                    clearInterval(gameInterval);
                    gameInterval = null;
                    sessionPauseStart = Date.now();
                    playSound('pause');
                    drawGame();
                } else if (gameState === 'paused') {
                    gameState = 'playing';
                    if (sessionPauseStart) {
                        const pauseDuration = Date.now() - sessionPauseStart;
                        sessionPausedTime += pauseDuration;
                        if (gameMode === 'timeAttack') {
                            timeAttackEnd += pauseDuration;
                        }
                        sessionPauseStart = 0;
                    }
                    gameInterval = setInterval(updateGame, getSpeed());
                    playSound('resume');
                    drawGame();
                }
                return;
            }

            if (e.key === 'm' || e.key === 'M') {
                muted = muted ? 0 : 1;
                try { localStorage.setItem('snake_muted', muted); } catch(e) { /* localStorage unavailable */ }
                return;
            }

            if (e.key === 'Tab') {
                e.preventDefault();
                showStatsPanel();
                return;
            }
            if (e.key === 'c' || e.key === 'C') {
                e.preventDefault();
                if (gameState === 'playing') return;
                showCosmeticsPanel();
                return;
            }

            if (e.key === 'Escape') {
                document.getElementById('statsPanel').style.display = 'none';
                document.getElementById('achievementsPanel').style.display = 'none';
                document.getElementById('cosmeticsPanel').style.display = 'none';
                return;
            }

            if (e.key === 'f' || e.key === 'F') {
                e.preventDefault();
                showAchievementsPanel();
                return;
            }

            if (gameState !== 'playing') return;

            let newDx = dx;
            let newDy = dy;

            switch (e.key) {
                case 'ArrowLeft':
                case 'a':
                    newDx = -TILE_SIZE;
                    newDy = 0;
                    break;
                case 'ArrowUp':
                case 'w':
                    newDx = 0;
                    newDy = -TILE_SIZE;
                    break;
                case 'ArrowRight':
                case 'd':
                    newDx = TILE_SIZE;
                    newDy = 0;
                    break;
                case 'ArrowDown':
                case 's':
                    newDx = 0;
                    newDy = TILE_SIZE;
                    break;
                default:
                    return;
            }

            const currentDir = nextDirection ?? { dx, dy };
            if (newDx !== -currentDir.dx || newDy !== -currentDir.dy) {
                nextDirection = { dx: newDx, dy: newDy };
            }
        });

        document.addEventListener('visibilitychange', () => {
            if (document.hidden && gameState === 'playing') {
                sessionPauseStart = Date.now();
                gameState = 'paused';
                clearInterval(gameInterval);
                gameInterval = null;
                playSound('pause');
                drawGame();
            }
        });

        resetGame();
        requestAnimationFrame(animateVisuals);
    </script>
</body>
</html>
